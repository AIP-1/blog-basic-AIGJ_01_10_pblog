# 이 파일을 .env로 복사해서 값을 채운다. .env는 Git에 올리지 않는다.
DB_PASSWORD=
MINIO_USER=minioadmin
MINIO_PASSWORD=

# log: 메일 대신 서버 로그에 인증번호를 찍는다 / smtp: 실제로 보낸다
MYBLOG_MAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# disk(기본) 또는 s3(MinIO)
MYBLOG_IMAGE_STORAGE=disk

# 소셜 로그인 (선택). CLIENT_ID가 있는 제공자만 켜진다
# 개발 중 돌아올 주소: http://localhost:5173/login/oauth2/code/kakao (구글은 /google). 실제 사이트는 SITE_URL로 정한다
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
